# Application Settings
APP_NAME="Auto Trade Sync App"
APP_VERSION="1.0.0"
DEBUG=false

# API Settings
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/auto_trade_sync"

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY="your-super-secret-key-change-this-immediately"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Telegram Configuration
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH="your_api_hash"
TELEGRAM_BOT_TOKEN=""  # Optional: if you want to use a bot
TELEGRAM_SESSION_NAME="auto_trade_bot"

# Angel One Configuration
ANGEL_ONE_API_KEY=""
ANGEL_ONE_CLIENT_ID=""

# Zerodha Configuration
ZERODHA_API_KEY=""
ZERODHA_API_SECRET=""

# Dhan Configuration
DHAN_CLIENT_ID=""
DHAN_ACCESS_TOKEN=""

# Upstox Configuration
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
UPSTOX_REDIRECT_URI="http://localhost:8000/api/v1/callback/upstox"

# Logging
LOG_LEVEL="INFO"
LOG_FILE="logs/auto_trade_sync.log"

# Signal Processing
MAX_SIGNAL_AGE_MINUTES=5
ENABLE_SIGNAL_VALIDATION=true
